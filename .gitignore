# Local investigation evidence caches (track reports/manifests instead)
investigations/*/sources/

# Acquisition payloads stay local; authored reports, collectors and manifests
# remain visible to Git even when older tasks placed them beside raw material.
/investigations/*/evidence/**
!/investigations/*/evidence/**/
!/investigations/*/evidence/**/*.md
!/investigations/*/evidence/**/*.py
!/investigations/*/evidence/**/*manifest*.json
!/investigations/*/evidence/**/MANIFEST.json
