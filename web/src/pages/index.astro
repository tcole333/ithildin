---
import BaseLayout from '../layouts/BaseLayout.astro';
import { readFileSync, existsSync } from 'fs';
import { resolve } from 'path';

const contentDir = resolve(process.cwd(), '..', 'content');

let dossierIndex: Array<{ name: string; slug: string; stats: any; last_updated?: string }> = [];
const dossierIndexPath = resolve(contentDir, 'dossiers', '_index.json');
if (existsSync(dossierIndexPath)) {
  dossierIndex = JSON.parse(readFileSync(dossierIndexPath, 'utf-8'));
}

let networkStats = { total_nodes: 0, person_nodes: 0, entity_nodes: 0, total_edges: 0 };
const networkPath = resolve(contentDir, 'network.json');
if (existsSync(networkPath)) {
  const network = JSON.parse(readFileSync(networkPath, 'utf-8'));
  networkStats = network.stats;
}

const totalFindings = dossierIndex.reduce((sum, d) => sum + d.stats.total_findings, 0);
const totalConnections = networkStats.total_edges;
---
<BaseLayout title="Overview">
  <div class="space-y-16">
    <section class="surface beam p-8 md:p-12 reveal" style="--delay: 0s;">
      <div class="grid gap-10 md:grid-cols-[1.1fr_0.9fr] items-center">
        <div class="space-y-6">
          <div class="section-label">Overview</div>
          <h1 class="text-4xl md:text-5xl font-display text-moon">Ithildin</h1>
          <p class="font-body text-lg md:text-xl text-mithril leading-relaxed max-w-xl">
            Public records, court filings, and released documents — structured, cited, and cross-referenced.
          </p>
        </div>
        <div class="space-y-4">
          <div class="surface-muted p-6 flex items-center justify-center">
            <img src="/ithildin-logo.png" alt="Ithildin mark" class="w-56 opacity-90" />
          </div>
          <div class="rune-divider"></div>
          <p class="text-sm text-mithril font-body">
            Every claim links to its source. Primary records where possible.
          </p>
        </div>
      </div>
    </section>

    <section class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <div class="surface p-5 reveal" style="--delay: 0.1s;">
        <div class="section-label">Findings</div>
        <div class="text-3xl font-mono text-moon mt-3">{totalFindings.toLocaleString()}</div>
        <div class="text-xs text-mithril mt-2">From cited sources</div>
      </div>
      <div class="surface p-5 reveal" style="--delay: 0.15s;">
        <div class="section-label">Dossiers</div>
        <div class="text-3xl font-mono text-moon mt-3">{dossierIndex.length}</div>
        <div class="text-xs text-mithril mt-2">Entity profiles</div>
      </div>
      <div class="surface p-5 reveal" style="--delay: 0.2s;">
        <div class="section-label">Entities</div>
        <div class="text-3xl font-mono text-moon mt-3">{networkStats.entity_nodes}</div>
        <div class="text-xs text-mithril mt-2">Persons & organizations</div>
      </div>
      <div class="surface p-5 reveal" style="--delay: 0.25s;">
        <div class="section-label">Connections</div>
        <div class="text-3xl font-mono text-moon mt-3">{totalConnections.toLocaleString()}</div>
        <div class="text-xs text-mithril mt-2">Documented links</div>
      </div>
    </section>

    <section class="space-y-6">
      <div class="flex items-center justify-between">
        <h2 class="text-2xl font-semibold text-moon">Explore</h2>
        <div class="rune-divider flex-1 ml-6"></div>
      </div>
      <div class="grid md:grid-cols-2 gap-4">
        <a href="/dossiers" class="surface p-6 transition">
          <div class="section-label">Dossiers</div>
          <h3 class="text-xl text-moon mt-3">Dossiers and evidence trails</h3>
          <p class="text-sm text-mithril mt-2 font-body">
            Profiles with findings, connections, roles, and timelines.
          </p>
        </a>
        <a href="/articles" class="surface p-6 transition">
          <div class="section-label">Articles</div>
          <h3 class="text-xl text-moon mt-3">Mechanisms and systemic analysis</h3>
          <p class="text-sm text-mithril mt-2 font-body">
            Longform investigations into money flows, corporate structures, and systemic patterns.
          </p>
        </a>
        <a href="/network" class="surface p-6 transition">
          <div class="section-label">Network</div>
          <h3 class="text-xl text-moon mt-3">Interactive network graph</h3>
          <p class="text-sm text-mithril mt-2 font-body">
            Interactive graph of people, organizations, and their documented relationships.
          </p>
        </a>
        <a href="/financials" class="surface p-6 transition">
          <div class="section-label">Financial Flows</div>
          <h3 class="text-xl text-moon mt-3">Money paths and trust architecture</h3>
          <p class="text-sm text-mithril mt-2 font-body">
            Visualize transfers, shells, and mechanisms that move capital through the network.
          </p>
        </a>
      </div>
    </section>

    <section class="space-y-6">
      <div class="flex items-center justify-between">
        <h2 class="text-2xl font-semibold text-moon">Top Dossiers</h2>
        <div class="rune-divider flex-1 ml-6"></div>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3">
        {dossierIndex.slice(0, 18).map(d => (
          <a href={`/dossiers/${d.slug}`} class="surface p-4 transition">
            <div class="flex items-center justify-between gap-4">
              <div>
                <div class="text-sm text-moon font-semibold">{d.name}</div>
                <div class="text-xs text-mithril mt-1">
                  {d.stats.total_findings} findings / {d.stats.total_connections} connections
                </div>
              </div>
              <div class="text-xs text-mithril font-mono">{d.stats.total_entities}</div>
            </div>
          </a>
        ))}
      </div>
      {dossierIndex.length > 18 && (
        <a href="/dossiers" class="text-sm text-mithril font-body">
          View all {dossierIndex.length} dossiers &rarr;
        </a>
      )}
    </section>
  </div>
</BaseLayout>
