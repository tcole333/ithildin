---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { readdirSync, readFileSync, existsSync } from 'fs';
import { resolve, basename } from 'path';

const articlesDir = resolve(process.cwd(), '..', 'content', 'articles');

interface ArticleMeta {
  slug: string;
  title: string;
  subtitle?: string;
  cluster?: string;
  targets?: string[];
  wordCount?: number;
}

let articles: ArticleMeta[] = [];

if (existsSync(articlesDir)) {
  const files = readdirSync(articlesDir).filter(f => f.endsWith('.mdx'));
  for (const file of files) {
    const content = readFileSync(resolve(articlesDir, file), 'utf-8');
    const frontmatterMatch = content.match(/^---\n([\s\S]*?)\n---/);
    if (frontmatterMatch) {
      const lines = frontmatterMatch[1].split('\n');
      const meta: any = { slug: basename(file, '.mdx') };
      for (const line of lines) {
        const [key, ...valueParts] = line.split(':');
        if (key && valueParts.length > 0) {
          const value = valueParts.join(':').trim().replace(/^["']|["']$/g, '');
          meta[key.trim()] = value;
        }
      }
      meta.wordCount = content.split(/\s+/).length;
      articles.push(meta);
    }
  }
}

const planned = [
  { title: "The Parallel Diplomatic Corps", subtitle: "How IPI, HDI, and Gratitude America functioned as influence infrastructure outside FARA", cluster: "parallel-diplomatic-corps" },
  { title: "The Apollo Money Pipeline", subtitle: "How $158M+ flowed from 3 billionaires to a convicted sex offender", cluster: "apollo-money-pipeline" },
  { title: "Wexner Trust Architecture", subtitle: "A masterclass in using trusts to obscure beneficial ownership", cluster: "wexner-trust-architecture" },
  { title: "Deutsche Bank Plumbing", subtitle: "What 579 transactions and $304M tell us about compliance theater", cluster: "deutsche-bank-plumbing" },
  { title: "The Gulf Intelligence Web", subtitle: "The geopolitics of a financier's Rolodex", cluster: "gulf-intelligence-web" },
  { title: "The Corporate Shell Network", subtitle: "The corporate structure diagram that takes a full wall", cluster: "corporate-shell-network" },
  { title: "The Legal Shield", subtitle: "When your lawyers are also your intelligence service", cluster: "legal-shield" },
  { title: "Science & Tech Interface", subtitle: "Philanthropy as a social technology", cluster: "science-tech-interface" },
  { title: "Inner Circle Operations", subtitle: "The org chart of a criminal enterprise that filed its taxes", cluster: "inner-circle-operations" },
  { title: "USVI Operations", subtitle: "Why the US Virgin Islands is the Delaware of the Caribbean", cluster: "usvi-operations" },
];

const publishedSlugs = new Set(articles.map(a => a.slug));
const unwritten = planned.filter(p => !publishedSlugs.has(p.cluster));

const backlinksPath = resolve(process.cwd(), '..', 'content', 'backlinks.json');
let clusterDossiers: Record<string, any[]> = {};
if (existsSync(backlinksPath)) {
  const backlinks = JSON.parse(readFileSync(backlinksPath, 'utf-8'));
  clusterDossiers = backlinks.cluster_to_dossier || {};
}
---
<BaseLayout title="Articles">
  <div class="space-y-10">
    <section class="surface beam p-8 reveal" style="--delay: 0s;">
      <div class="space-y-4">
        <div class="section-label">Longform</div>
        <h1 class="text-3xl md:text-4xl font-display text-moon">Investigative Articles</h1>
        <p class="text-mithril font-body max-w-2xl">
          Long-form analyses of money flows, corporate mechanisms, and systemic patterns across the investigation.
        </p>
      </div>
    </section>

    {articles.length > 0 && (
      <section class="space-y-4">
        <div class="flex items-center justify-between">
          <h2 class="text-xl font-semibold text-moon">Published</h2>
          <div class="rune-divider flex-1 ml-6"></div>
        </div>
        <div class="grid gap-4">
          {articles.map((article, idx) => (
            <a
              href={`/articles/${article.slug}`}
              class="surface p-6 transition reveal"
              style={`--delay: ${Math.min(idx * 0.05, 0.4)}s;`}
            >
              <div class="section-label">Article</div>
              <h3 class="text-xl text-moon mt-3">{article.title}</h3>
              {article.subtitle && <p class="text-sm text-mithril mt-2 font-body">{article.subtitle}</p>}
              {article.wordCount && (
                <div class="text-xs text-mithril mt-4 font-mono">
                  {Math.round(article.wordCount / 1000)}K words / {Math.ceil(article.wordCount / 250)} min read
                </div>
              )}
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="space-y-4">
      <div class="flex items-center justify-between">
        <h2 class="text-xl font-semibold text-moon">Planned</h2>
        <div class="rune-divider flex-1 ml-6"></div>
      </div>
      <div class="grid md:grid-cols-2 gap-4">
        {unwritten.map((article, idx) => {
          const dossiers = clusterDossiers[article.cluster] || [];
          return (
            <div class="surface-muted p-5 reveal" style={`--delay: ${Math.min(idx * 0.04, 0.4)}s;`}>
              <div class="section-label">Planned</div>
              <h3 class="text-lg text-moon mt-3">{article.title}</h3>
              <p class="text-xs text-mithril mt-2 font-body">{article.subtitle}</p>
              {dossiers.length > 0 && (
                <div class="flex flex-wrap gap-2 mt-4">
                  {dossiers.slice(0, 6).map((d: any) => (
                    <a href={`/dossiers/${d.slug}`} class="chip" style="letter-spacing: 0.14em;">
                      {d.name}
                    </a>
                  ))}
                  {dossiers.length > 6 && (
                    <span class="text-xs text-mithril">+{dossiers.length - 6} more</span>
                  )}
                </div>
              )}
            </div>
          );
        })}
      </div>
    </section>
  </div>
</BaseLayout>
