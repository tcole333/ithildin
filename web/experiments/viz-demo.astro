---
<BaseLayout title="Visualization Demo">
  <div class="space-y-10">
    <section class="surface beam p-8 reveal" style="--delay: 0s;">
      <div class="space-y-3">
        <div class="section-label">Visualization</div>
        <h1 class="text-3xl md:text-4xl font-display text-moon">Component Library</h1>
        <p class="text-mithril font-body">
          Interactive visualization primitives for the Ithildin investigation platform.
          Three components designed for financial and network analysis of investigative data.
        </p>
      </div>
    </section>

    <!-- Timeline Chart -->
    <section class="space-y-4 reveal" style="--delay: 0.1s;">
      <div class="flex items-baseline gap-4">
        <h2 class="text-xl font-display text-moon">Timeline</h2>
        <span class="text-xs text-mithril font-mono">TimelineChart.tsx</span>
      </div>
      <p class="text-sm text-mithril">
        Horizontal timeline of events across the Epstein network. Color-coded by event type.
        Scroll to zoom, drag to pan. Below: grouped by entity.
      </p>
      <TimelineChart
        events={timelineEvents}
        groupBy="entity"
        height={420}
        client:visible
      />
    </section>

    <!-- Transaction Table -->
    <section class="space-y-4 reveal" style="--delay: 0.2s;">
      <div class="flex items-baseline gap-4">
        <h2 class="text-xl font-display text-moon">Transactions</h2>
        <span class="text-xs text-mithril font-mono">TransactionTable.tsx</span>
      </div>
      <p class="text-sm text-mithril">
        Sortable, filterable table of financial transactions. Click column headers to sort.
        Filter by entity name or amount range. Running totals update with filters.
      </p>
      <TransactionTable
        transactions={transactions}
        title="Key Financial Flows"
        client:visible
      />
    </section>

    <!-- Ego Network -->
    <section class="space-y-4 reveal" style="--delay: 0.3s;">
      <div class="flex items-baseline gap-4">
        <h2 class="text-xl font-display text-moon">Ego Network</h2>
        <span class="text-xs text-mithril font-mono">EgoNetwork.tsx</span>
      </div>
      <p class="text-sm text-mithril">
        Force-directed graph centered on a single entity. Edge thickness encodes relationship
        strength, color encodes type. Hover highlights connected subgraph. 2-hop view below.
      </p>
      <EgoNetwork
        center="Jeffrey Epstein"
        connections={egoConnections}
        secondHop={egoSecondHop}
        depth={2}
        height={520}
        client:visible
      />
    </section>

    <!-- Corporate Structure -->
    <section class="space-y-4 reveal" style="--delay: 0.35s;">
      <div class="flex items-baseline gap-4">
        <h2 class="text-xl font-display text-moon">Corporate Structure</h2>
        <span class="text-xs text-mithril font-mono">CorporateStructure.tsx</span>
      </div>
      <p class="text-sm text-mithril">
        Top-down ownership diagram using Sugiyama DAG layout. Entity types encoded as shapes,
        jurisdictions as stroke colors, relationship types as edge colors, evidence quality as
        dashes. Click nodes to highlight ancestor/descendant chains. Click +/- to collapse
        subtrees.
      </p>
      <CorporateStructure
        data={structureData}
        height={600}
        client:visible
      />
    </section>

    <!-- Corporate Structure V2 -->
    <section class="space-y-4 reveal" style="--delay: 0.36s;">
      <div class="flex items-baseline gap-4">
        <h2 class="text-xl font-display text-moon">Corporate Structure V2 (Left-to-Right)</h2>
        <span class="text-xs text-mithril font-mono">CorporateStructureV2.tsx</span>
      </div>
      <p class="text-sm text-mithril">
        Horizontal ownership diagram using Sugiyama DAG layout. Solves the horizontal sprawl issue by scrolling vertically. Entity types encoded as shapes, jurisdictions as stroke colors, relationship types as edge colors, evidence quality as dashes.
      </p>
      <CorporateStructureV2
        data={structureData}
        height={800}
        client:visible
      />
    </section>

    <!-- Corporate Structure V2 - Full Network -->
    <section class="space-y-4 reveal" style="--delay: 0.365s;">
      <div class="flex items-baseline gap-4">
        <h2 class="text-xl font-display text-moon">Corporate Structure V2 - Full Shell Network</h2>
        <span class="text-xs text-mithril font-mono">CorporateStructureV2.tsx</span>
      </div>
      <p class="text-sm text-mithril">
        Testing the V2 component with the full, dense 30+ entity network structure used in the main article.
      </p>
      <CorporateStructureV2
        data={shellNetworkData}
        height={600}
        client:visible
      />
    </section>

    <!-- Information Waterfall (Step Diagram) -->
    <section class="space-y-4 reveal" style="--delay: 0.37s;">
      <div class="flex items-baseline gap-4">
        <h2 class="text-xl font-display text-moon">Information Waterfall</h2>
        <span class="text-xs text-mithril font-mono">StepDiagram.tsx</span>
      </div>
      <p class="text-sm text-mithril">
        A progressive disclosure diagram showing information degradation step-by-step. Replaces the Sankey diagram which is unsuitable for non-financial or sequential qualitative flows.
      </p>
      <StepDiagram
        data={waterfallData}
        client:visible
      />
    </section>

    <!-- Article Embedding Convention -->
    <section class="surface p-6 space-y-4 reveal" style="--delay: 0.4s;">
      <div class="section-label">Convention</div>
      <h2 class="text-xl font-display text-moon">Article Embedding</h2>
      <p class="text-sm text-mithril font-body leading-relaxed">
        To embed a visualization in an MDX article, use a data-attribute marker.
        The hydrator script scans for <code class="text-ember bg-[rgba(18,21,27,0.8)] border border-[rgba(42,49,59,0.6)] px-1.5 py-0.5 rounded text-xs">&lt;div data-viz="..."&gt;</code> elements
        and mounts the corresponding React component with props loaded from the JSON source.
      </p>
      <div class="surface-muted p-4 font-mono text-xs text-mithril leading-relaxed overflow-x-auto">
        <div class="text-icy">&lt;!-- In your .mdx article: --&gt;</div>
        <div class="mt-2">&lt;div data-viz="<span class="text-ember">TimelineChart</span>"</div>
        <div class="pl-5">data-src="<span class="text-moon">/content/timelines/apollo.json</span>"</div>
        <div class="pl-5">data-height="<span class="text-moon">400</span>"</div>
        <div class="pl-5">data-group-by="<span class="text-moon">entity</span>"&gt;&lt;/div&gt;</div>
        <div class="mt-4">&lt;div data-viz="<span class="text-ember">TransactionTable</span>"</div>
        <div class="pl-5">data-src="<span class="text-moon">/content/financials/transactions.json</span>"&gt;&lt;/div&gt;</div>
        <div class="mt-4">&lt;div data-viz="<span class="text-ember">EgoNetwork</span>"</div>
        <div class="pl-5">data-src="<span class="text-moon">/content/ego/leon-black.json</span>"</div>
        <div class="pl-5">data-depth="<span class="text-moon">2</span>"&gt;&lt;/div&gt;</div>
      </div>
      <div class="text-xs text-mithril font-body mt-2">
        JSON files follow the same prop shape as the component. The hydrator fetches the JSON,
        merges any data-attribute overrides, and mounts the React component. Articles remain
        readable without JS — the surrounding prose provides context.
      </div>
    </section>
  </div>
</BaseLayout>
