---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { readFileSync, existsSync } from 'fs';
import { resolve } from 'path';

const contentDir = resolve(process.cwd(), '..', 'content');
const dossierIndexPath = resolve(contentDir, 'dossiers', '_index.json');

let dossierIndex: Array<{ name: string; slug: string; stats: any; last_updated?: string }> = [];
if (existsSync(dossierIndexPath)) {
  dossierIndex = JSON.parse(readFileSync(dossierIndexPath, 'utf-8'));
}
---
<BaseLayout title="Dossiers">
  <div class="space-y-10">
    <section class="surface beam p-8 reveal" style="--delay: 0s;">
      <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <div>
          <div class="section-label">Index</div>
          <h1 class="text-3xl md:text-4xl font-display text-moon mt-3">Target Dossiers</h1>
          <p class="text-mithril font-body mt-4 max-w-2xl">
            Each dossier is a stone record: findings, connections, and corporate roles consolidated
            with evidence. Updated as new sources surface.
          </p>
        </div>
        <div class="surface-muted px-6 py-4">
          <div class="section-label">Total</div>
          <div class="text-3xl font-mono text-moon mt-2">{dossierIndex.length}</div>
          <div class="text-xs text-mithril mt-1">Tracked targets</div>
        </div>
      </div>
    </section>

    <div class="grid gap-3">
      {dossierIndex.map((d, idx) => (
        <a
          href={`/dossiers/${d.slug}`}
          class="surface p-5 transition reveal"
          style={`--delay: ${Math.min(idx * 0.02, 0.4)}s;`}
        >
          <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
            <div class="space-y-2">
              <div class="text-moon font-semibold">{d.name}</div>
              {d.stats.finding_types && (
                <div class="flex flex-wrap gap-2 text-xs text-mithril">
                  {Object.entries(d.stats.finding_types).slice(0, 4).map(([type, count]) => (
                    <span class="chip" style="letter-spacing: 0.14em;">{type}: {count}</span>
                  ))}
                </div>
              )}
            </div>
            <div class="flex flex-wrap gap-4 text-xs text-mithril font-mono">
              <span>{d.stats.total_findings} findings</span>
              <span>{d.stats.total_connections} connections</span>
              <span>{d.stats.total_entities} entities</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
