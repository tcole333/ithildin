---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { readFileSync, existsSync } from 'fs';
import { resolve } from 'path';

const contentDir = resolve(process.cwd(), '..', 'content');
const dossierIndexPath = resolve(contentDir, 'dossiers', '_index.json');

let dossierIndex: Array<{ name: string; slug: string; stats: any }> = [];
if (existsSync(dossierIndexPath)) {
  dossierIndex = JSON.parse(readFileSync(dossierIndexPath, 'utf-8'));
}
---
<BaseLayout title="Dossiers">
  <div class="space-y-6">
    <div>
      <h1 class="text-3xl font-bold tracking-tight">Target Dossiers</h1>
      <p class="text-gray-400 mt-2">{dossierIndex.length} targets with sourced findings, connections, and corporate affiliations.</p>
    </div>

    <div class="grid gap-3">
      {dossierIndex.map(d => (
        <a href={`/dossiers/${d.slug}`} class="flex items-center justify-between bg-gray-900 border border-gray-800 rounded-lg px-5 py-4 hover:border-gray-700 transition-colors group">
          <div>
            <span class="text-gray-200 group-hover:text-white font-medium transition-colors">{d.name}</span>
            {d.stats.finding_types && (
              <div class="flex gap-2 mt-1.5">
                {Object.entries(d.stats.finding_types).map(([type, count]) => (
                  <span class="text-xs text-gray-500">{type}: {count}</span>
                ))}
              </div>
            )}
          </div>
          <div class="flex items-center gap-4 text-sm text-gray-500 shrink-0">
            <span>{d.stats.total_findings} findings</span>
            <span>{d.stats.total_connections} connections</span>
            <span>{d.stats.total_entities} entities</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
