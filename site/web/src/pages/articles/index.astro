---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { readdirSync, readFileSync, existsSync } from 'fs';
import { resolve, basename } from 'path';

const articlesDir = resolve(process.cwd(), '..', 'content', 'articles');

interface ArticleMeta {
  slug: string;
  title: string;
  subtitle?: string;
  cluster?: string;
  targets?: string[];
  wordCount?: number;
}

let articles: ArticleMeta[] = [];

// Read article frontmatter from MDX files
if (existsSync(articlesDir)) {
  const files = readdirSync(articlesDir).filter(f => f.endsWith('.mdx'));
  for (const file of files) {
    const content = readFileSync(resolve(articlesDir, file), 'utf-8');
    const frontmatterMatch = content.match(/^---\n([\s\S]*?)\n---/);
    if (frontmatterMatch) {
      const lines = frontmatterMatch[1].split('\n');
      const meta: any = { slug: basename(file, '.mdx') };
      for (const line of lines) {
        const [key, ...valueParts] = line.split(':');
        if (key && valueParts.length > 0) {
          const value = valueParts.join(':').trim().replace(/^["']|["']$/g, '');
          meta[key.trim()] = value;
        }
      }
      meta.wordCount = content.split(/\s+/).length;
      articles.push(meta);
    }
  }
}

// Planned articles (story clusters)
const planned = [
  { title: "The Apollo Money Pipeline", subtitle: "How $158M+ flowed from 3 billionaires to a convicted sex offender", cluster: "apollo-money-pipeline" },
  { title: "Wexner Trust Architecture", subtitle: "A masterclass in using trusts to obscure beneficial ownership", cluster: "wexner-trust-architecture" },
  { title: "Deutsche Bank Plumbing", subtitle: "What 579 transactions and $304M tell us about compliance theater", cluster: "deutsche-bank-plumbing" },
  { title: "The Gulf Intelligence Web", subtitle: "The geopolitics of a financier's Rolodex", cluster: "gulf-intelligence-web" },
  { title: "Shadow Lobbying Empire", subtitle: "How to lobby Congress without technically lobbying Congress", cluster: "shadow-lobbying-empire" },
  { title: "The Corporate Shell Network", subtitle: "The corporate structure diagram that takes a full wall", cluster: "corporate-shell-network" },
  { title: "The Legal Shield", subtitle: "When your lawyers are also your intelligence service", cluster: "legal-shield" },
  { title: "Science & Tech Interface", subtitle: "Philanthropy as a social technology", cluster: "science-tech-interface" },
  { title: "The Norwegian Connection", subtitle: "An ex-diplomat, a defense minister, and a registered sex offender", cluster: "norwegian-connection" },
  { title: "Inner Circle Operations", subtitle: "The org chart of a criminal enterprise that filed its taxes", cluster: "inner-circle-operations" },
  { title: "USVI Operations", subtitle: "Why the US Virgin Islands is the Delaware of the Caribbean", cluster: "usvi-operations" },
  { title: "The Political Influence Machine", subtitle: "Campaign finance as relationship management", cluster: "political-influence-machine" },
];

const publishedSlugs = new Set(articles.map(a => a.slug));
const unwritten = planned.filter(p => !publishedSlugs.has(p.cluster));

// Load cluster→dossier backlinks for planned articles
const backlinksPath = resolve(process.cwd(), '..', 'content', 'backlinks.json');
let clusterDossiers: Record<string, any[]> = {};
if (existsSync(backlinksPath)) {
  const backlinks = JSON.parse(readFileSync(backlinksPath, 'utf-8'));
  clusterDossiers = backlinks.cluster_to_dossier || {};
}
---
<BaseLayout title="Articles">
  <div class="space-y-8">
    <div>
      <h1 class="text-3xl font-bold tracking-tight">Investigative Articles</h1>
      <p class="text-gray-400 mt-2 max-w-2xl">
        Deep-dive analyses into mechanisms, money flows, and systemic patterns.
        Written in a style that explains the plumbing — how money actually moves,
        what compliance checks should have caught it, and what makes these structures possible.
      </p>
    </div>

    {articles.length > 0 && (
      <div class="space-y-4">
        <h2 class="text-xl font-semibold">Published</h2>
        {articles.map(article => (
          <a href={`/articles/${article.slug}`} class="block bg-gray-900 border border-gray-800 rounded-lg p-5 hover:border-gray-700 transition-colors group">
            <h3 class="text-lg font-semibold text-gray-200 group-hover:text-white">{article.title}</h3>
            {article.subtitle && <p class="text-sm text-gray-400 mt-1">{article.subtitle}</p>}
            {article.wordCount && <span class="text-xs text-gray-600 mt-2 inline-block">{Math.round(article.wordCount / 1000)}K words</span>}
          </a>
        ))}
      </div>
    )}

    <div class="space-y-4">
      <h2 class="text-xl font-semibold text-gray-400">{articles.length > 0 ? 'Planned' : 'Planned Articles'}</h2>
      <div class="grid md:grid-cols-2 gap-3">
        {unwritten.map(article => {
          const dossiers = clusterDossiers[article.cluster] || [];
          return (
            <div class="bg-gray-900/50 border border-gray-800/50 rounded-lg p-4">
              <h3 class="text-sm font-semibold text-gray-400">{article.title}</h3>
              <p class="text-xs text-gray-500 mt-1">{article.subtitle}</p>
              {dossiers.length > 0 && (
                <div class="flex flex-wrap gap-1 mt-2">
                  {dossiers.slice(0, 6).map((d: any) => (
                    <a href={`/dossiers/${d.slug}`}
                       class="text-xs text-blue-400/70 hover:text-blue-400 bg-gray-800/50 rounded px-1.5 py-0.5">
                      {d.name}
                    </a>
                  ))}
                  {dossiers.length > 6 && (
                    <span class="text-xs text-gray-600">+{dossiers.length - 6} more</span>
                  )}
                </div>
              )}
            </div>
          );
        })}
      </div>
    </div>
  </div>
</BaseLayout>
