---
import BaseLayout from '../layouts/BaseLayout.astro';
import { readFileSync, existsSync } from 'fs';
import { resolve } from 'path';

// Load data
const contentDir = resolve(process.cwd(), '..', 'content');

let dossierIndex: Array<{ name: string; slug: string; stats: any }> = [];
const dossierIndexPath = resolve(contentDir, 'dossiers', '_index.json');
if (existsSync(dossierIndexPath)) {
  dossierIndex = JSON.parse(readFileSync(dossierIndexPath, 'utf-8'));
}

let networkStats = { total_nodes: 0, person_nodes: 0, entity_nodes: 0, total_edges: 0 };
const networkPath = resolve(contentDir, 'network.json');
if (existsSync(networkPath)) {
  const network = JSON.parse(readFileSync(networkPath, 'utf-8'));
  networkStats = network.stats;
}

const totalFindings = dossierIndex.reduce((sum, d) => sum + d.stats.total_findings, 0);
const totalConnections = networkStats.total_edges;
---
<BaseLayout title="Overview">
  <div class="space-y-12">
    <!-- Header -->
    <div class="space-y-4">
      <h1 class="text-4xl font-bold tracking-tight">Epstein Network Investigation</h1>
      <p class="text-lg text-gray-400 max-w-3xl">
        Open-source intelligence research into Jeffrey Epstein's financial, social, and
        corporate network. Built from 600K+ primary source documents, court filings,
        corporate registries, and financial records across 35+ data sources.
      </p>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <div class="bg-gray-900 border border-gray-800 rounded-lg p-5">
        <div class="text-3xl font-bold text-white">{totalFindings.toLocaleString()}</div>
        <div class="text-sm text-gray-400 mt-1">Findings</div>
      </div>
      <div class="bg-gray-900 border border-gray-800 rounded-lg p-5">
        <div class="text-3xl font-bold text-white">{dossierIndex.length}</div>
        <div class="text-sm text-gray-400 mt-1">Targets</div>
      </div>
      <div class="bg-gray-900 border border-gray-800 rounded-lg p-5">
        <div class="text-3xl font-bold text-white">{networkStats.entity_nodes}</div>
        <div class="text-sm text-gray-400 mt-1">Entities</div>
      </div>
      <div class="bg-gray-900 border border-gray-800 rounded-lg p-5">
        <div class="text-3xl font-bold text-white">{totalConnections.toLocaleString()}</div>
        <div class="text-sm text-gray-400 mt-1">Connections</div>
      </div>
    </div>

    <!-- Sections -->
    <div class="grid md:grid-cols-2 gap-6">
      <a href="/articles" class="group bg-gray-900 border border-gray-800 rounded-lg p-6 hover:border-gray-700 transition-colors">
        <h2 class="text-xl font-semibold group-hover:text-white transition-colors">Investigative Articles</h2>
        <p class="text-sm text-gray-400 mt-2">
          Deep-dive analyses into mechanisms, money flows, and systemic patterns. How did $158M move from
          three billionaires to a convicted sex offender through legitimate banking channels?
        </p>
      </a>

      <a href="/dossiers" class="group bg-gray-900 border border-gray-800 rounded-lg p-6 hover:border-gray-700 transition-colors">
        <h2 class="text-xl font-semibold group-hover:text-white transition-colors">Target Dossiers</h2>
        <p class="text-sm text-gray-400 mt-2">
          {dossierIndex.length} individual profiles with sourced findings, verified connections,
          corporate roles, and chronological timelines.
        </p>
      </a>

      <a href="/network" class="group bg-gray-900 border border-gray-800 rounded-lg p-6 hover:border-gray-700 transition-colors">
        <h2 class="text-xl font-semibold group-hover:text-white transition-colors">Network Graph</h2>
        <p class="text-sm text-gray-400 mt-2">
          Interactive force-directed visualization of {networkStats.person_nodes} people and {networkStats.entity_nodes} entities
          connected by {totalConnections.toLocaleString()} documented relationships.
        </p>
      </a>

      <a href="/financials" class="group bg-gray-900 border border-gray-800 rounded-lg p-6 hover:border-gray-700 transition-colors">
        <h2 class="text-xl font-semibold group-hover:text-white transition-colors">Financial Flows</h2>
        <p class="text-sm text-gray-400 mt-2">
          Sankey diagrams tracing money through trust companies, shell corporations, and offshore
          entities. Deutsche Bank DS10 data: 579 transactions, $304M total.
        </p>
      </a>
    </div>

    <!-- Top Targets -->
    <div>
      <h2 class="text-xl font-semibold mb-4">Top Targets by Findings</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3">
        {dossierIndex.slice(0, 18).map(d => (
          <a href={`/dossiers/${d.slug}`} class="flex items-center justify-between bg-gray-900 border border-gray-800 rounded-lg px-4 py-3 hover:border-gray-700 transition-colors group">
            <span class="text-sm text-gray-300 group-hover:text-white transition-colors">{d.name}</span>
            <div class="flex items-center gap-2 text-xs text-gray-500">
              <span>{d.stats.total_findings} findings</span>
              <span class="text-gray-700">|</span>
              <span>{d.stats.total_connections} conn</span>
            </div>
          </a>
        ))}
      </div>
      {dossierIndex.length > 18 && (
        <a href="/dossiers" class="inline-block mt-3 text-sm text-gray-400 hover:text-gray-300">
          View all {dossierIndex.length} targets →
        </a>
      )}
    </div>
  </div>
</BaseLayout>
