---
interface Props {
  finding: {
    id: number;
    finding_type: string;
    summary: string;
    detail?: string;
    confidence: string;
    date_of_event?: string;
    claim_type?: string;
    verification_status?: string;
    evidence?: Array<{
      evidence_type: string;
      evidence_ref: string;
      source_quote?: string;
    }>;
  };
  compact?: boolean;
}

const { finding, compact = false } = Astro.props;

const typeColors: Record<string, string> = {
  financial: 'bg-emerald-900/50 text-emerald-300 border-emerald-700/50',
  communication: 'bg-blue-900/50 text-blue-300 border-blue-700/50',
  relationship: 'bg-purple-900/50 text-purple-300 border-purple-700/50',
  legal: 'bg-amber-900/50 text-amber-300 border-amber-700/50',
  corporate: 'bg-cyan-900/50 text-cyan-300 border-cyan-700/50',
  intelligence: 'bg-red-900/50 text-red-300 border-red-700/50',
  identity: 'bg-pink-900/50 text-pink-300 border-pink-700/50',
  location: 'bg-teal-900/50 text-teal-300 border-teal-700/50',
  document: 'bg-gray-800/50 text-gray-300 border-gray-600/50',
};

const confidenceColors: Record<string, string> = {
  confirmed: 'text-green-400',
  high: 'text-blue-400',
  medium: 'text-yellow-400',
  low: 'text-orange-400',
  unverified: 'text-gray-500',
};

const typeColor = typeColors[finding.finding_type] || typeColors.document;
const confColor = confidenceColors[finding.confidence] || confidenceColors.unverified;
---
<div class={`border border-gray-800 rounded-lg p-4 ${compact ? 'p-3' : 'p-4'}`}>
  <div class="flex items-start justify-between gap-3 mb-2">
    <div class="flex items-center gap-2 flex-wrap">
      <span class={`text-xs px-2 py-0.5 rounded border ${typeColor}`}>
        {finding.finding_type}
      </span>
      <span class={`text-xs ${confColor}`}>
        {finding.confidence}
      </span>
      {finding.date_of_event && (
        <span class="text-xs text-gray-500">{finding.date_of_event}</span>
      )}
    </div>
    {finding.verification_status && finding.verification_status !== 'unverified' && (
      <span class={`text-xs px-1.5 py-0.5 rounded ${
        finding.verification_status === 'verified' ? 'bg-green-900/50 text-green-400' :
        finding.verification_status === 'disputed' ? 'bg-red-900/50 text-red-400' :
        'bg-gray-800 text-gray-500'
      }`}>
        {finding.verification_status}
      </span>
    )}
  </div>
  <p class="text-sm text-gray-200">{finding.summary}</p>
  {!compact && finding.detail && (
    <p class="text-xs text-gray-400 mt-2 leading-relaxed">{finding.detail}</p>
  )}
  {!compact && finding.evidence && finding.evidence.length > 0 && (
    <div class="mt-3 space-y-1">
      {finding.evidence.slice(0, 3).map(ev => (
        <div class="text-xs text-gray-500 flex items-start gap-1.5">
          <span class="text-gray-600 shrink-0">[{ev.evidence_type}]</span>
          <span class="font-mono text-gray-500 truncate">{ev.evidence_ref}</span>
        </div>
      ))}
      {finding.evidence.length > 3 && (
        <span class="text-xs text-gray-600">+{finding.evidence.length - 3} more sources</span>
      )}
    </div>
  )}
</div>
