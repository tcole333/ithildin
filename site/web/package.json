{
  "name": "web",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "test:e2e": "playwright test",
    "test:citations": "node scripts/test-citations.mjs",
    "test:citations:snapshots": "node scripts/test-citation-snapshots.mjs",
    "test:support-spans": "node scripts/test-support-spans.mjs",
    "lint:citations": "node scripts/lint-citations.mjs",
    "lint:citations:changed": "node scripts/lint-citations.mjs --changed-files --strict-changed-files",
    "lint:citations:update-baseline": "node scripts/lint-citations.mjs --update-baseline",
    "report:support-coverage": "node scripts/report-support-coverage.mjs",
    "report:support-coverage:changed": "node scripts/report-support-coverage.mjs --changed-files",
    "preview": "astro preview",
    "astro": "astro",
    "deploy": "npm run lint:citations && npm run test:citations && npm run test:citations:snapshots && npm run build && npx wrangler pages deploy dist/ --project-name=ithildin --branch=main --commit-dirty=true",
    "deploy:preview": "npm run lint:citations && npm run test:citations && npm run test:citations:snapshots && npm run build && npx wrangler pages deploy dist/ --project-name=ithildin --branch=preview --commit-dirty=true"
  },
  "dependencies": {
    "@astrojs/react": "^4.4.2",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.18",
    "@types/d3": "^7.4.3",
    "@types/d3-sankey": "^0.12.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "astro": "^5.17.1",
    "d3": "^7.9.0",
    "d3-dag": "^1.1.0",
    "d3-sankey": "^0.12.3",
    "marked": "^17.0.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2"
  }
}
